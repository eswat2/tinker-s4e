{
  "name": "tinker-s4e",
  "version": "0.0.987",
  "description": "prototype - a demo rendered with Svelte and Tailwind",
  "author": "eswat2",
  "license": "MIT",
  "repository": "eswat2/tinker-s4e",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bump": "bumpp patch --commit --tag --push --yes",
    "deploy-app": "cd dist; ln -s ../.vercel; vc --prod",
    "release": "pnpm bump && pnpm build && pnpm deploy-app",
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently \"pnpm:twx --watch\" \"pnpm:start\"",
    "twx": "twx",
    "start": "vite",
    "prebuild": "echo skipping pnpm format",
    "build": "pnpm twx; vite build",
    "serve": "vite preview",
    "test": "echo --skip...",
    "cc": "prettier --check './src/**/*.{css,pcss,js,svelte}'",
    "format": "prettier --write './src/**/*.{css,pcss,js,svelte}'",
    "spell": "cspell './**/*.js'",
    "open": "open https://tinker-s4e.vercel.app"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "autoprefixer": "10.6.2",
    "bumpp": "12.3.0",
    "concurrently": "10.0.7",
    "d3-interpolate": "3.0.2",
    "only-allow": "1.2.2",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "proto-tailwindcss-clrs": "0.0.578",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "yoctocolors": "2.2.0"
  },
  "packageManager": "pnpm@12.18.0"
}
