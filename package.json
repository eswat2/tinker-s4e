{
  "name": "tinker-s4e",
  "version": "0.0.973",
  "description": "prototype - a demo rendered with Svelte and Tailwind",
  "author": "eswat2",
  "license": "MIT",
  "repository": "eswat2/tinker-s4e",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bump": "bumpp patch --commit --tag --push --yes",
    "deploy-app": "cd dist; ln -s ../.vercel; vc --prod",
    "release": "pnpm bump && pnpm build && pnpm deploy-app",
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently \"pnpm:twx --watch\" \"pnpm:start\"",
    "twx": "twx",
    "start": "vite",
    "prebuild": "echo skipping pnpm format",
    "build": "pnpm twx; vite build",
    "serve": "vite preview",
    "test": "echo --skip...",
    "cc": "prettier --check './src/**/*.{css,pcss,js,svelte}'",
    "format": "prettier --write './src/**/*.{css,pcss,js,svelte}'",
    "spell": "cspell './**/*.js'",
    "open": "open https://tinker-s4e.vercel.app"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "autoprefixer": "10.6.1",
    "bumpp": "12.3.0",
    "concurrently": "10.0.6",
    "d3-interpolate": "3.0.1",
    "only-allow": "1.2.2",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "proto-tailwindcss-clrs": "0.0.567",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "yoctocolors": "2.2.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
